# Copy to .env.local and fill in real values. Never commit .env.local itself.
# For cloud EAS builds, these are pulled automatically from EAS Environment
# Variables based on the build profile's "environment" field in eas.json -
# this file is only needed for local `expo start` / Expo Go.

# Backend API base URL (local IP, or the staging Vercel Preview URL)
EXPO_PUBLIC_API_URL=

# Clerk (Dashboard -> API Keys -> Publishable key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat PUBLIC SDK keys (RevenueCat -> Project settings -> API keys). One per store.
# Leave blank to build without in-app purchases (the paywall then says they're unavailable).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional, dev/staging only: the invite server address when it is not invite.groupthatapp.com
# (same value as the backend's INVITE_BASE_URL). Leave unset for production builds.
EXPO_PUBLIC_INVITE_BASE_URL=

# Native Google sign-in (Android). Google Cloud project groupthat-eb006 -> Credentials.
# Web client = the client in Clerk's Google connection; Android client = the one for the Play app signing key.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
