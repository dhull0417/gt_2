# Copy to .env.local and fill in real values. Never commit .env.local itself.
# For cloud EAS builds, these are pulled automatically from EAS Environment
# Variables based on the build profile's "environment" field in eas.json -
# this file is only needed for local `expo start` / Expo Go.

# Backend API base URL (local IP, or the staging Vercel Preview URL)
EXPO_PUBLIC_API_URL=

# Clerk (Dashboard -> API Keys -> Publishable key)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
