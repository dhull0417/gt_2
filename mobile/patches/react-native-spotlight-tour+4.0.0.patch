+const AnimatedPath = Animated.createAnimatedComponent(Path);
+export const PathShape = memo(props => {
+    const { padding, path, setReference, spot, useNativeDriver } = props;
+    const width = spot.width + padding;
+    const height = spot.height + padding;
+    const x = spot.x - (padding / 2);
+    const y = spot.y - (padding / 2);
+    const [shown, setShown] = useState({ height, width, x, y });
+    const opacity = useRef(new Animated.Value(0)).current;
+    useEffect(() => {
+        const next = { height, width, x, y };
+        Animated.timing(opacity, { duration: 150, toValue: 0, useNativeDriver }).start(() => {
+            setShown(next);
+            // Nothing to highlight (before the first step, or hidden while the page scrolls): stay dark.
