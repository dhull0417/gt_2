+++ b/node_modules/react-native-spotlight-tour/src/lib/components/tour-overlay/shapes/PathShape.component.tsx
@@ -0,0 +1,38 @@
+// GroupThat patch: a rectangle spot drawn from a caller-supplied SVG path (ShapeOptions.path), so the
+// cut-out can match the highlighted item's shape (e.g. a squircle tile). Always fades between spots:
+// out where it was, move while hidden, then in at the new spot.
+import { memo, useEffect, useMemo, useRef, useState } from "react";
+import isEqual from "react-fast-compare";
+import { Animated, type LayoutRectangle } from "react-native";
+import { Path } from "react-native-svg";
+
+import type { ShapeProps } from "../../../../helpers/shape";
+
+const AnimatedPath = Animated.createAnimatedComponent(Path);
+
+export const PathShape = memo<ShapeProps & { path: (rect: LayoutRectangle) => string }>(props => {
+  const { padding, path, setReference, spot, useNativeDriver } = props;
+  const width = spot.width + padding;
+  const height = spot.height + padding;
+  const x = spot.x - (padding / 2);
+  const y = spot.y - (padding / 2);
+
+  const [shown, setShown] = useState<LayoutRectangle>({ height, width, x, y });
+  const opacity = useRef(new Animated.Value(0)).current;
+
+  useEffect(() => {
+    const next = { height, width, x, y };
+    Animated.timing(opacity, { duration: 150, toValue: 0, useNativeDriver }).start(() => {
+      setShown(next);
+      // Nothing to highlight (before the first step, or hidden while the page scrolls): stay dark.
+      if (spot.width <= 0 || spot.height <= 0) return;
+      Animated.timing(opacity, { duration: 200, toValue: 1, useNativeDriver }).start();
+    });
+    setReference({ measure: callback => callback(x, y, width, height) });
+    return () => setReference(undefined);
+  }, [x, y, width, height, spot.width, spot.height, setReference, useNativeDriver]);
+
+  const d = useMemo(() => path(shown), [path, shown]);
+
+  return <AnimatedPath d={d} fill="black" opacity={opacity} />;
+}, isEqual);
