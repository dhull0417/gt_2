# Copy to .env and fill in real values. Never commit .env itself.

PORT=5001
NODE_ENV=development

# Clerk (Dashboard -> API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# MongoDB Atlas connection string (Atlas -> Cluster -> Connect)
MONGO_URI=

# Arcjet (Dashboard -> API Keys)
ARCJET_ENV=development
ARCJET_KEY=

# Cloudinary (currently unused in active code paths, kept for parity with existing config)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret required by the /api/jobs cron endpoints
CRON_SECRET=

# Comma-separated Clerk user ids that are treated as Premium without a
# subscription (testing only; computed at read time, nothing is written to the
# database). Set it on Vercel's Preview scope / your local .env, NOT Production.
PREMIUM_TEST_CLERK_IDS=

# RevenueCat (Premium subscriptions). Set these on Vercel for every scope that serves the app.
# Secret API key: RevenueCat -> Project settings -> API keys -> Secret API keys (v1, read access).
REVENUECAT_SECRET_API_KEY=
# Any long random string. Paste the SAME value into RevenueCat -> Integrations -> Webhooks -> Authorization header.
REVENUECAT_WEBHOOK_AUTH=
# Name of the entitlement in RevenueCat that unlocks Premium (default: premium)
REVENUECAT_ENTITLEMENT=premium

# Google Cloud Console -> APIs & Services -> Credentials (Places API (New) enabled)
GOOGLE_PLACES_API_KEY=

# Stream (currently unused in active code paths, kept for parity with existing config)
STREAM_API_KEY=
STREAM_API_SECRET=

# Chat push notifications. The database calls POST /api/chat/webhook/message for every
# new chat message (pg_net trigger). Any long random string; the SAME value goes into
# the Supabase private.app_settings row 'chat_webhook_secret'.
CHAT_WEBHOOK_SECRET=
# Set to "webhook" once the database trigger is live: the old app-triggered push
# endpoint (PATCH /api/groups/:id/last-message) then becomes a no-op so nobody is
# notified twice. Leave unset until the Supabase migration + settings are in place.
CHAT_PUSH_MODE=
# Optional: lets the server post "Sam joined the group" lines into chat. Supabase ->
# Project Settings -> API. The service-role key is a BACKEND-ONLY secret (Vercel env var).
# NEVER put it in the mobile app or any EXPO_PUBLIC_ variable. Unset = feature is off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lifecycle emails (Resend). Master switch: nothing is sent unless this is "true".
LIFECYCLE_EMAILS_ENABLED=false
# Resend -> API Keys
RESEND_API_KEY=
# Resend -> Webhooks (svix signing secret, starts with whsec_) for bounces/complaints
RESEND_WEBHOOK_SECRET=
# Sender shown to users; the domain must be verified in Resend (SPF/DKIM DNS records).
EMAIL_FROM=GroupThat <info@groupthatapp.com>
EMAIL_REPLY_TO=
# Required in every marketing email footer (CAN-SPAM)
EMAIL_POSTAL_ADDRESS=
# Any long random string; signs unsubscribe links
EMAIL_UNSUBSCRIBE_SECRET=
# Optional: price wording in upgrade emails. Keep in sync with the App Store / Play prices.
# EMAIL_PRICE_TEXT=$4.99 per month or $39.99 per year
# Public URL of this backend, used for unsubscribe and button links (no trailing slash)
PUBLIC_BASE_URL=https://gt-2-peach.vercel.app

# Cutover switches. Each is OFF unless set to exactly "true"; off = the behaviour the live 1.3.x app
# already has. Turn them on (Production) only once nearly everyone runs the new app; check with
# `node src/scripts/appVersionReport.js`. Leave them off in Preview too unless you are testing them.
# Waitlist + auto-promotion only for Premium groups (off: every group has a waitlist).
PREMIUM_WAITLIST_ENFORCED=
# Muting a group quiets all its pushes (off: a mute only quiets pushes about the next meetup).
MUTE_ALL_PUSHES_ENABLED=
# "Sam joined the group" lines in chat (also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY).
CHAT_SYSTEM_MESSAGES_ENABLED=
# Separate Android notification channels for chat and reminders (off: everything uses 'default').
PUSH_CHANNELS_ENABLED=
